{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "basketball-analytics",
	"compatibility_date": "2026-08-24",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"workers_dev": true,
	"preview_urls": true,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "basketball-analytics"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"vars": {
		"DATA_PROVIDER": "nba",
		// Workers Paid: restore full product (no free-tier UI/data stripping).
		"FULL_EDGE_PRODUCT": "1"
	},
	// Paid plan default is 30s; raise so player islands / live enrich finish.
	"limits": {
		"cpu_ms": 120000
	}
}

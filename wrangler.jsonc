{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Thin HTML/API edge — Cache API + KV only. Custom domains stay on this name.
	// MISS / uncached paths forward to basketball-analytics-origin (OpenNext).
	"main": "worker.ts",
	"name": "basketball-analytics",
	"compatibility_date": "2026-08-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// drbl.io and www.drbl.io are Workers Custom Domains attached once through the API,
	// not listed under "routes", so CI deploys never need DNS rights on the zone.
	"workers_dev": true,
	"preview_urls": false,
	"observability": {
		"enabled": true,
		"logs": {
			"invocation_logs": false,
			"head_sampling_rate": 0.05
		}
	},
	"services": [
		{
			"binding": "ORIGIN",
			"service": "basketball-analytics-origin"
		}
	],
	"kv_namespaces": [
		{
			"binding": "PAGE_CACHE",
			"id": "4267118315b64cb48a533e1543d22e21"
		}
	],
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"ratelimits": [
		{
			"name": "API_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 60,
				"period": 60
			}
		}
	],
	"triggers": {
		// Re-fill PAGE_CACHE / API Cache API so visitor MISSes stay rare.
		"crons": ["*/5 * * * *"]
	},
	"limits": {
		// Cache hits are tiny; MISS just waits on the origin binding.
		"cpu_ms": 10000
	}
}

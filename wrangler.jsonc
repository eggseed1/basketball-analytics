{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Wraps the generated .open-next/worker.js to rate limit /api/* and cache
	// player/team HTML before Next runs.
	"main": "worker.ts",
	"name": "basketball-analytics",
	"compatibility_date": "2026-08-24",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"workers_dev": true,
	"preview_urls": false,
	// Only console.* output (errors/warnings) is kept, 7 days. Per-request invocation
	// logs stay off; the privacy page promises no request logging.
	"observability": {
		"enabled": true,
		"logs": {
			"invocation_logs": false,
			"head_sampling_rate": 1
		}
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "basketball-analytics"
		}
	],
	// Rendered player/team HTML, 15 minute TTL. See worker.ts.
	"kv_namespaces": [
		{
			"binding": "PAGE_CACHE",
			"id": "4267118315b64cb48a533e1543d22e21"
		}
	],
	// Cache keys include the version id so a deploy never serves HTML that
	// points at the previous build's chunks.
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"ratelimits": [
		{
			// Per client IP, per Cloudflare location, and counted loosely across machines,
			// so the real ceiling is a few times this. Live pages poll a few times a minute.
			// Newly picked namespace IDs never denied in testing; 1001 does (workers-sdk#15417).
			// Keys are prefixed "api:" because counters are shared account-wide per namespace.
			"name": "API_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 60,
				"period": 60
			}
		}
	],
	"vars": {
		"DATA_PROVIDER": "nba",
		// Workers Paid: restore full product (no free-tier UI/data stripping).
		"FULL_EDGE_PRODUCT": "1"
	},
	// Paid plan default is 30s; raise so player islands / live enrich finish.
	"limits": {
		"cpu_ms": 120000
	}
}

{
  "manifest_version": 3,
  "name": "DRBL Live",
  "short_name": "DRBL Live",
  "version": "1.2.2",
  "description": "Live NBA scores in the same ScoreTile style as drbl.io/scores, with team logos and in-game headshots.",
  "homepage_url": "https://drbl.io",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://drbl.io/*"],
  "action": {
    "default_title": "DRBL Live scores",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html"
}

{
  "manifest_version": 3,
  "name": "DRBL Live",
  "short_name": "DRBL Live",
  "version": "0.2.0",
  "description": "Live NBA scores and favorite-team alerts, powered by drbl.io.",
  "permissions": ["storage", "alarms", "notifications", "sidePanel"],
  "host_permissions": ["https://drbl.io/*"],
  "action": { "default_title": "DRBL Live scores", "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "side_panel": { "default_path": "popup.html" }
}

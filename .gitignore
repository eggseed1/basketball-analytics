# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# historical game caches (BallDontLie pulls)
/data/cache/

# historical PBP corpus (external import — do not commit event dumps)
/data/pbp/**
!/data/pbp/README.md

# typescript
*.tsbuildinfo
next-env.d.ts

# Possession calibration caches / checkpoints (summaries under artifacts/pbp-calibration may be committed)
/artifacts/pbp-calibration/cache/
/artifacts/pbp-calibration/checkpoint.json
/artifacts/pbp-calibration/**/checkpoint.json
/artifacts/pbp-calibration/**/*.log
/artifacts/daily-runtime-sync.json

# DRBL offline pipeline caches (immutable NBA raw + normalized outputs)
/data/drbl/

# Local scratch / large research intermediates (seals + summaries remain tracked)
/.tmp/
/reports/historical-lineup-yield/
/reports/m18a/raw/
/reports/m17a_1/import/import_ledger.jsonl
/reports/m17a_1/07_raw_manifest.csv

/reports/m17a_1/import/

# Local raw acquisition dumps (not product runtime)
/data/raw/

# Deploy-baked shot charts for Cloudflare Static Assets (large; rebuilt on deploy)
/public/runtime/player-shots/
# Deploy-baked game logs for Cloudflare Static Assets
/public/runtime/player-game-logs/
# Deploy-baked play-by-play for Cloudflare Static Assets
/public/runtime/play-by-play/
# Large runtime JSON copied from src/data/runtime at deploy (ASSETS, not script)
/public/runtime/season-tables-snapshot.json
/public/runtime/game-snapshot.json
/public/runtime/transactions-snapshot.json
/public/runtime/sentiment-snapshot.json
/public/runtime/team-board-snapshot.json
/public/runtime/impact-overlay-snapshot.json
/public/runtime/asset-ledger-snapshot.json
/public/runtime/team-game-box-snapshot.json
/public/runtime/drbl-overlay-snapshot.json
# percentile-pools may already live here for ASSETS; copy script refreshes it
/public/runtime/percentile-pools-snapshot.json
# Deploy-baked share images (scripts/build-share-images.ts)
/public/og/

# OpenNext
.open-next

# wrangler files
.wrangler
# Ask DRBL agent database dump (scripts/build-ask-db.ts)
.ask-db
.dev.vars*
!.dev.vars.example

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# historical game caches (BallDontLie pulls)
/data/cache/

# historical PBP corpus (external import — do not commit event dumps)
/data/pbp/**
!/data/pbp/README.md

# typescript
*.tsbuildinfo
next-env.d.ts

# Possession calibration caches / checkpoints (summaries under artifacts/pbp-calibration may be committed)
/artifacts/pbp-calibration/cache/
/artifacts/pbp-calibration/checkpoint.json
/artifacts/pbp-calibration/**/checkpoint.json

# DRBL offline pipeline caches (immutable NBA raw + normalized outputs)
/data/drbl/

# Local scratch / large research intermediates (seals + summaries remain tracked)
/.tmp/
/reports/m18a/raw/
/reports/m17a_1/import/import_ledger.jsonl
/reports/m17a_1/07_raw_manifest.csv

/reports/m17a_1/import/


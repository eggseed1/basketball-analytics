# Data provider: local (sample) | nba (live ESPN-backed; stats.nba.com + BRef also present)
# Local default without this file: local sample.
# Vercel / production MUST set DATA_PROVIDER=nba (or rely on VERCEL→nba fallback).
DATA_PROVIDER=nba

# M16k1 canonical ability source (default validated after cutover).
# Set to legacy to point loaders/tests at pre-cutover semantics during rollback drills.
# DRBL_CANONICAL_ABILITY_SOURCE=validated
# Legacy shadow flag (obsolete after cutover; kept for reference).
# DRBL_VALIDATED_ABILITY_SHADOW=false

# BallDontLie (https://app.balldontlie.io) — required for games 1960–present.
# Free tier: teams, players, games.
# ALL-STAR: game player stats. GOAT: box scores + advanced stats.
BALLDONTLIE_API_KEY=

# Optional: absolute or repo-relative path to an externally imported PBP corpus.
# Expects <path>/manifest.json. Default when unset: data/pbp/
# Attaching a corpus does NOT enable ASK/Game Lab PBP queries by itself.
# PBP_DATA_PATH=

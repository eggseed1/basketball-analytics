# Data provider: local (sample) | nba (live ESPN-backed)
# Local default without this file: local sample.
# Vercel / production MUST set DATA_PROVIDER=nba (or rely on VERCEL→nba fallback).
DATA_PROVIDER=nba

# BallDontLie (https://app.balldontlie.io) — required for games 1960–present.
# Free tier: teams, players, games.
# ALL-STAR: game player stats. GOAT: box scores + advanced stats.
BALLDONTLIE_API_KEY=
